{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "music-box",
  "version": "0.2.0",
  "identifier": "cz.musicbox.display",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "music-box",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "backgroundColor": "#1b1036"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/build/": "web/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Party jukebox: shows what is playing and the queue; people add songs from their phones."
  }
}
